{
  "name": "personal-intelligence-feed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal news intelligence: world + tech agents, signal detector, daily briefing.",
  "scripts": {
    "brief": "node src/run.js",
    "ingest": "node src/run.js --ingest-only",
    "start": "node src/server.js",
    "chat:fetch": "node src/chat-mode.js fetch",
    "chat:finish": "node src/chat-mode.js finish",
    "reads:fetch": "node src/reads.js fetch",
    "reads:draft": "node src/reads.js draft",
    "reads:finish": "node src/reads.js finish",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "rss-parser": "^3.13.0"
  }
}
